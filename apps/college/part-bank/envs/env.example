# Part Bank API Environment Configuration

# Server Configuration
PORT=3002
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
DATABASE_URL="file:./part_bank.db"

# Authentication (will integrate with gateway)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Gateway Configuration
GATEWAY_URL=http://localhost:3000
GATEWAY_AUTH_ENDPOINT=/api/auth

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=900000

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png

# Logging
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# API Documentation
API_TITLE="Part Bank API"
API_DESCRIPTION="Minimal banking-style API with user auth, deposit accounts, and transaction feed"
API_VERSION="1.0.0"